% Down & Up Audio
clc;
clear;
[x, Fs1] = audioread('Tauba_2.wav');
x = x(:,1);
% Down Sampling
N1 = length(x);
for n = 1:1:(N1/2)
    y(n) = x(2*n);
endfor
subplot(3,1,1), stem(x), xlabel('Original Signal');
subplot(3,1,2), stem(y), xlabel('Down Sampled Signal');
% Up Sampling
N2 = length(y);
for n = 2:2:(N2*2)
    z(n) = y(n/2);
endfor
subplot(3,1,3), stem(z), xlabel('Up Sampled Signal');
z1 = z;
n3 = length(z);
for n = 3:2:n3-1
    z1(n) = (z(n-1) + z(n+1))/2;
endfor
% Save audio files
% audiowrite('down.wav', y, Fs1);
% audiowrite('up.wav', z, Fs1);
audiowrite('AvgUp.wav', z1, Fs1);
